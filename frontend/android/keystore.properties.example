# ==============================================================================
# Fasal Drishti - Android Release Keystore Properties (Template)
# ==============================================================================
# Copy this file to "keystore.properties" in this directory:
#   cp keystore.properties.example keystore.properties
#
# DO NOT COMMIT "keystore.properties" OR ANY ".jks" / ".keystore" FILES TO GIT!
#
# Generate a new keystore if you don't already have one:
#   keytool -genkey -v -keystore fasal-drishti-release.jks -alias fasaldrishti -keyalg RSA -keysize 2048 -validity 10000
#
# Fill in your actual values:
storeFile=../fasal-drishti-release.jks
storePassword=YourStorePasswordHere
keyAlias=fasaldrishti
keyPassword=YourKeyPasswordHere

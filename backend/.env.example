PORT=5000
NODE_ENV=production
JWT_SECRET=krishi_drishti_jwt_secret_2026_production_key

# Optional: Remote MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/krishi_drishti?retryWrites=true&w=majority
# If left blank, the backend auto-initializes with the embedded in-memory MongoDB server.
MONGODB_URI=

# Optional: OpenWeatherMap API key for live weather in any district
OPENWEATHER_API_KEY=

# Google Gemini AI Key (Required for AI Agricultural Advisor & Multimodal Crop Diagnosis)
# Obtain your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Copernicus Data Space Ecosystem (CDSE) / Sentinel-2 Satellite Credentials
# Register for free at: https://dataspace.copernicus.eu/
# Navigate to User Settings -> OAuth Clients to generate your free Client ID and Client Secret
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_INSTANCE_ID=
